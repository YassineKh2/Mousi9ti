# Accounts are optional and disabled by default. Local-only use needs no values.
# Enable only after configuring Google and Convex Auth; see docs/google-auth.md.
VITE_ACCOUNTS_ENABLED=false
# The Convex CLI writes actual deployment values to .env.local during setup.
# CONVEX_DEPLOYMENT=dev:your-development-deployment
# VITE_CONVEX_URL=https://your-development-deployment.convex.cloud
# VITE_CONVEX_SITE_URL=https://your-development-deployment.convex.site
# Never put a deploy key, auth secret, or other credential in a VITE_ variable.
# Server-only Convex dashboard variables (not frontend .env values):
# SITE_URL, JWT_PRIVATE_KEY, JWKS, AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET.